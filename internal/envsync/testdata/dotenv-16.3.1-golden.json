  {
    "name": "rendered-dev-vars",
    "src": "# ============================================================\n# Managed by keyto env sync. Edits above the local overrides line are lost.\n# Re-run: keyto env sync\n# Local overrides: end this file with the line \"# local overrides below\"\n# and put your own KEY=value lines under it; env sync keeps them.\n# KEYTO_* keys are set by the platform and never belong here.\n# ============================================================\n\n# Secrets from uat (fetched via Hub)\n# NOT WRITTEN: ALL_QUOTES (its value can't be written so wrangler reads it back unchanged: it contains both ' and `, and also \" or a literal \\n or \\r)\nBACKTICK='run `ls`'\nBS_NEWLINE=\"a\\\\nb\"\n# NOT WRITTEN: BS_N_QUOTES (its value can't be written so wrangler reads it back unchanged: it contains both ' and `, and also \" or a literal \\n or \\r)\nCRLF=\"one\\r\\ntwo\"\n# NOT WRITTEN: CR_AND_QUOTE (its value can't be written so wrangler reads it back unchanged: it has a carriage return as well as a \" or a literal \\n or \\r)\nCR_ONLY=\"one\\rtwo\"\nDOUBLE_QUOTE='say \"hi\"'\nEMPTY=''\nEQUALS=a=b==c\nESCAPED_QUOTES='\\\"x\\\"'\nHASH='abc#def # not a comment'\n# NOT WRITTEN: HASH_BS (its value can't be written so wrangler reads it back unchanged: it ends with a backslash and needs quotes)\nINJECTION=\"x\\nKEYTO_DEV_USER=0\\nEVIL=1\"\nJSON_KEY='{\"type\":\"service_account\",\"private_key\":\"-----BEGIN PRIVATE KEY-----\\nMIIEvQ\\n-----END PRIVATE KEY-----\\n\",\"client_email\":\"x@y.iam\"}'\nLINE_SEP=\"x y z\"\nLITERAL_BS_N=literal \\n and \\r stay\nMARKERISH='# local overrides below, but not the line'\n# NOT WRITTEN: MARKER_LINE (its value can't be written so wrangler reads it back unchanged: it contains the line \"# local overrides below\")\nNEWLINES=\"line one\\nline two\\n\"\nPRETTY_JSON='{\n  \"a\": \"b\\nc\"\n}'\nQUOTED_START=`'starts with a quote`\nSINGLE_QUOTE=`it's`\nSPACES='  padded  '\nTAB=a\tb\nTRAILING_BS=ends with \\\nTWO_QUOTES=`it's \"quoted\"`\nUNICODE=naïve café 日本 🎉\nUNICODE_SPACES=' x　'\nWIN_PATH=C:\\new\\temp\nWRAPPED='\"wrapped\"'\n\n# Signs you in as the local dev user (@hemfrid/workers-auth).\nKEYTO_DEV_USER=1\n\n# local overrides below\nMINE=1\n",
    "parsed": {
      "BACKTICK": "run `ls`",
      "BS_NEWLINE": "a\\\nb",
      "CRLF": "one\r\ntwo",
      "CR_ONLY": "one\rtwo",
      "DOUBLE_QUOTE": "say \"hi\"",
      "EMPTY": "",
      "EQUALS": "a=b==c",
      "ESCAPED_QUOTES": "\\\"x\\\"",
      "HASH": "abc#def # not a comment",
      "INJECTION": "x\nKEYTO_DEV_USER=0\nEVIL=1",
      "JSON_KEY": "{\"type\":\"service_account\",\"private_key\":\"-----BEGIN PRIVATE KEY-----\\nMIIEvQ\\n-----END PRIVATE KEY-----\\n\",\"client_email\":\"x@y.iam\"}",
      "LINE_SEP": "x y z",
      "LITERAL_BS_N": "literal \\n and \\r stay",
      "MARKERISH": "# local overrides below, but not the line",
      "NEWLINES": "line one\nline two\n",
      "PRETTY_JSON": "{\n  \"a\": \"b\\nc\"\n}",
      "QUOTED_START": "'starts with a quote",
      "SINGLE_QUOTE": "it's",
      "SPACES": "  padded  ",
      "TAB": "a\tb",
      "TRAILING_BS": "ends with \\",
      "TWO_QUOTES": "it's \"quoted\"",
